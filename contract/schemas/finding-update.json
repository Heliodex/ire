{
	"type": "object",
	"properties": {
		"makerAction": {
			"type": "string",
			"maxLength": 4000
		},
		"resolution": {
			"type": "string",
			"maxLength": 4000
		},
		"severity": {
			"type": "string",
			"pattern": "^(block|fixable|note|hold)$"
		},
		"status": {
			"type": "string",
