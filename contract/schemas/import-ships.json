{
	"type": "object",
	"properties": {
		"ships": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"reviews": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"acknowledgements": {
									"type": "array",
									"items": {
										"type": "string"
									}
								},
								"decided_at": {
									"type": "string",
									"minLength": 1
								},
								"decision": {
									"type": "string",
									"pattern": "^(approved|changes|rejected)$"
								},
								"hours_approved_seconds": {
									"type": "integer",
									"minimum": 0
								},
								"internal_note": {
									"type": "string"
								},
								"note_to_maker": {
									"type": "string"
								},
								"reviewer_email": {
									"type": "string",
									"minLength": 1
								},
								"reviewer_name": {
									"type": "string"
								},
								"stage": {
									"type": "integer",
									"minimum": 1,
									"maximum": 2
								}
							},
							"required": [
								"decided_at",
								"decision",
								"hours_approved_seconds",
								"reviewer_email",
								"stage"
							],
							"title": "ImportReview"
						}
					},
					"ship": {
						"$ref": "ingest.json"
					},
					"version": {
						"type": "integer",
						"minimum": 1
					}
				},
				"required": [
					"reviews",
					"ship"
				],
				"title": "ImportShip"
			}
		}
	},
	"required": [
		"ships"
	],
	"title": "ImportShipsRequest",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wt.example/ire/import-ships.json"
}
