	"required": [
		"submission",
		"checks",
		"journals",
		"bom",
		"reviews",
		"events",
		"priorReviews",
		"acknowledgements",
		"policy"
	],
	"title": "ReviewBundle",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wt.example/review/review-bundle.json"
}
