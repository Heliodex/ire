			}
		},
		"priorReviews": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"result": {
						"type": "string",
						"minLength": 1
					},
					"feedback": {
						"type": "string"
					},
					"reviewer": {
						"type": "string"
					},
					"at": {
						"type": "string"
					},
					"invalidated": {
						"type": "integer"
					}
				},
				"required": [
					"result"
				],
				"title": "PriorReview"
			}
		},
		"claim": {
			"type": "object",
			"properties": {
				"reviewerEmail": {
					"type": "string",
					"minLength": 1
				},
				"reviewerName": {
					"type": "string"
				},
				"expiresAt": {
					"type": "string",
					"minLength": 1
				},
				"isMine": {
					"type": "integer",
					"minimum": 0,
					"maximum": 1
				}
			},
			"required": [
				"reviewerEmail",
				"expiresAt",
				"isMine"
			],
			"title": "ClaimState"
		},
		"draft": {
			"type": "object",
			"properties": {
				"note": {
					"type": "string"
				},
				"internalNote": {
					"type": "string"
				},
				"updatedAt": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": [
				"note",
				"internalNote",
				"updatedAt"
			],
			"title": "DraftState"
		},
		"acknowledgements": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"policy": {
			"type": "object",
			"properties": {
				"holdOnWarn": {
					"type": "integer",
					"minimum": 0,
					"maximum": 1
				},
				"holdMinApprovedSeconds": {
					"type": "integer",
					"minimum": 0
				},
				"holdTiers": {
					"type": "array",
					"items": {
						"type": "integer"
					}
				},
				"noteRequiredForChanges": {
					"type": "integer",
					"minimum": 0,
					"maximum": 1
				},
				"fraudMinStage": {
					"type": "integer",
					"minimum": 0
				}
			},
			"required": [
				"holdOnWarn",
				"holdMinApprovedSeconds",
				"holdTiers",
				"noteRequiredForChanges",
				"fraudMinStage"
			],
			"title": "ReviewPolicy"
		}
