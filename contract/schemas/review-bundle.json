{
	"type": "object",
	"properties": {
		"submission": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"externalId": {
					"type": "string",
					"minLength": 1
				},
				"version": {
					"type": "integer",
					"minimum": 0
				},
				"status": {
					"type": "string",
					"minLength": 1
				},
				"stage": {
					"type": "integer",
					"minimum": 0
				},
				"title": {
					"type": "string",
					"minLength": 1
				},
				"description": {
					"type": "string"
				},
				"track": {
					"type": "string",
					"minLength": 1
				},
				"theme": {
					"type": "string"
				},
				"phase": {
					"type": "string"
				},
				"week": {
					"type": "integer"
				},
				"makerEmail": {
					"type": "string",
					"minLength": 1
				},
				"makerName": {
					"type": "string"
				},
				"repoUrl": {
					"type": "string"
				},
				"demoUrl": {
					"type": "string"
				},
				"thumbnailUrl": {
					"type": "string"
				},
				"requestedTier": {
					"type": "integer"
				},
				"grantCapCents": {
					"type": "integer"
				},
				"bomTotalCents": {
					"type": "integer"
				},
				"hoursClaimedSeconds": {
					"type": "integer",
					"minimum": 0
				},
				"hoursJournalSeconds": {
					"type": "integer",
					"minimum": 0
				},
				"hoursHackatimeSeconds": {
					"type": "integer",
					"minimum": 0
				},
				"hoursApprovedSeconds": {
					"type": "integer"
				},
				"heldReason": {
					"type": "string"
				},
				"ingestedAt": {
					"type": "string",
					"minLength": 1
				},
				"decidedAt": {
					"type": "string"
				},
				"updatedAt": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": [
				"id",
				"externalId",
				"version",
				"status",
				"stage",
				"title",
				"track",
				"makerEmail",
				"hoursClaimedSeconds",
				"hoursJournalSeconds",
				"hoursHackatimeSeconds",
				"ingestedAt",
				"updatedAt"
			],
			"title": "Submission"
		},
		"checks": {
			"type": "array",
			"items": {
				"$ref": "check-result.json"
			}
		},
		"journals": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"at": {
						"type": "string",
						"minLength": 1
					},
					"seconds": {
						"type": "integer",
						"minimum": 0
					},
					"title": {
						"type": "string"
					},
					"text": {
						"type": "string"
					},
					"markdown": {
						"type": "string"
					},
					"mediaCount": {
						"type": "integer",
						"minimum": 0
					},
					"clipCount": {
						"type": "integer",
						"minimum": 0
					},
					"coveredSeconds": {
						"type": "integer",
						"minimum": 0
					}
				},
				"required": [
					"id",
					"at",
					"seconds",
					"mediaCount",
					"clipCount",
					"coveredSeconds"
				],
				"title": "JournalEntry"
			}
		},
		"bom": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
