					"quantity",
					"unitCostCents"
				],
				"title": "BomLine"
			}
		},
		"reviews": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"stage": {
						"type": "integer",
						"minimum": 0
					},
					"decision": {
						"type": "string",
						"minLength": 1
					},
					"noteToMaker": {
						"type": "string"
					},
					"internalNote": {
						"type": "string"
					},
					"hoursApprovedSeconds": {
						"type": "integer"
					},
					"reviewerEmail": {
						"type": "string",
						"minLength": 1
					},
					"reviewerName": {
						"type": "string"
					},
					"held": {
						"type": "integer",
						"minimum": 0
					},
					"createdAt": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"id",
					"stage",
					"decision",
					"noteToMaker",
					"reviewerEmail",
					"held",
					"createdAt"
				],
				"title": "Review"
			}
		},
		"events": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"kind": {
						"type": "string",
						"minLength": 1
					},
					"actorEmail": {
						"type": "string"
					},
					"data": {
						"type": "string"
					},
					"createdAt": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"id",
					"kind",
					"createdAt"
				],
