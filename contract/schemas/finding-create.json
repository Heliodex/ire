{
	"type": "object",
	"properties": {
		"detail": {
			"type": "string",
			"maxLength": 4000
		},
		"evidence": {
			"type": "string",
			"maxLength": 4000
		},
		"makerAction": {
			"type": "string",
			"maxLength": 4000
		},
		"question": {
			"type": "string",
			"maxLength": 200
		},
		"severity": {
			"type": "string",
			"pattern": "^(block|fixable|note|hold)$"
		},
		"station": {
			"type": "string",
			"minLength": 1,
			"maxLength": 120,
			"pattern": "\\S"
		},
		"summary": {
			"type": "string",
			"minLength": 1,
			"maxLength": 500,
			"pattern": "\\S"
		}
	},
	"required": [
		"severity",
		"station",
		"summary"
	],
	"title": "FindingCreateRequest",
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wt.example/ire/finding-create.json"
}
